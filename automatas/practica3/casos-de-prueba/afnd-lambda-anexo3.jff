<structure>
	<type>fa</type>
	<automaton>
		<!--Lista de estados.-->
		<state id="0" name="q0">
			<x>80.0</x>
			<y>120.0</y>
			<initial />
		</state>
		<state id="1" name="q1">
			<x>240.0</x>
			<y>120.0</y>
			<final />
		</state>
		<!--Lista de transiciones.-->
		<transition>
			<from>0</from>
			<to>1</to>
