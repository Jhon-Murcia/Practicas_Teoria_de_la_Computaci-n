<?xml version="1.0" encoding="UTF-8"?>
<automata tipo="AFD" nombre="Binarios múltiplos de 3">
  <descripcion>El estado r_i indica que el prefijo leído, como número binario, deja residuo i al dividir entre 3.</descripcion>
  <alfabeto>
    <simbolo>0</simbolo>
    <simbolo>1</simbolo>
  </alfabeto>
  <estados>
    <estado nombre="r0" inicial="true" aceptacion="true" x="110.0" y="200.0" />
    <estado nombre="r1" x="330.0" y="200.0" />
    <estado nombre="r2" x="550.0" y="200.0" />
  </estados>
  <transiciones>
    <transicion desde="r0" lee="0" hacia="r0" />
    <transicion desde="r0" lee="1" hacia="r1" />
    <transicion desde="r1" lee="0" hacia="r2" />
    <transicion desde="r1" lee="1" hacia="r0" />
    <transicion desde="r2" lee="0" hacia="r1" />
    <transicion desde="r2" lee="1" hacia="r2" />
  </transiciones>
</automata>
