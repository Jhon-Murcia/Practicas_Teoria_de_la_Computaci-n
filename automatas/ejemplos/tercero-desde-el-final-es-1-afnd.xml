<?xml version="1.0" encoding="UTF-8"?>
<automata tipo="AFND" nombre="Tercero desde el final es 1">
  <descripcion>Familia L_n = {w : el n-ésimo símbolo desde el final es 1}: el AFD mínimo tiene 2^n estados.</descripcion>
  <alfabeto>
    <simbolo>0</simbolo>
    <simbolo>1</simbolo>
  </alfabeto>
  <estados>
    <estado nombre="q0" inicial="true" x="100.0" y="200.0" />
    <estado nombre="q1" x="280.0" y="200.0" />
    <estado nombre="q2" x="460.0" y="200.0" />
    <estado nombre="q3" aceptacion="true" x="640.0" y="200.0" />
  </estados>
  <transiciones>
    <transicion desde="q0" lee="0" hacia="q0" />
    <transicion desde="q0" lee="1" hacia="q0" />
    <transicion desde="q0" lee="1" hacia="q1" />
    <transicion desde="q1" lee="0" hacia="q2" />
    <transicion desde="q1" lee="1" hacia="q2" />
    <transicion desde="q2" lee="0" hacia="q3" />
    <transicion desde="q2" lee="1" hacia="q3" />
  </transiciones>
</automata>
