<structure>
	<type>fa</type>
	<automaton>
		<!--Lista de estados.-->
		<state id="0" name="par">
			<x>140.0</x>
			<y>200.0</y>
			<initial />
			<final />
		</state>
		<state id="1" name="impar">
			<x>400.0</x>
			<y>200.0</y>
		</state>
		<!--Lista de transiciones.-->
		<transition>
			<from>0</from>
			<to>1</to>
			<read>a</read>
		</transition>
		<transition>
			<from>0</from>
			<to>0</to>
			<read>b</read>
		</transition>
		<transition>
			<from>1</from>
			<to>0</to>
			<read>a</read>
		</transition>
		<transition>
			<from>1</from>
			<to>1</to>
			<read>b</read>
		</transition>
	</automaton>
</structure>
